# Copy this file to backend/.env. Never commit the real file or a private key.
# Generate independent, long random values for SECRET_KEY and EVIDENCE_ENCRYPTION_KEY.
# SQLite is the default local database. Leave both values below blank to use backend/cybershield.db.
DATABASE_URL=
SQLITE_DB_PATH=
SECRET_KEY=replace-with-a-long-random-secret
EVIDENCE_ENCRYPTION_KEY=replace-with-a-different-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173
GEMINI_API_KEY=
# Gemini is implemented today. The remaining values reserve configuration for
# a future Hugging Face / Sentence Transformers campaign-intelligence service.
AI_PROVIDER=gemini
HUGGINGFACE_TOKEN=
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2
FAISS_INDEX_PATH=./data/faiss/campaigns.index
# Local AES-256-GCM evidence storage is implemented. These values prepare a
# future IPFS / MinIO adapter without placing credentials in source code.
EVIDENCE_STORAGE_DIR=./evidence/encrypted
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=cybershield-evidence
IPFS_API_URL=
# EVM ledger: use a dedicated test wallet only. Polygon Amoy chain ID is 80002.
# Example RPC: https://polygon-amoy.g.alchemy.com/v2/<key>
BLOCKCHAIN_RPC=
POLYGON_RPC=
CONTRACT_ADDRESS=
PRIVATE_KEY=
MAX_EVIDENCE_FILE_BYTES=10485760
PRIVATE_KEY=
CHAIN_ID=80002
