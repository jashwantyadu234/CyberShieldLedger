# ============================================================
# CYBERSHIELD LEDGER - BACKEND PRODUCTION ENVIRONMENT CONFIG
# ============================================================

# Secret Key for JWT Token Generation & Verification
SECRET_KEY=cybershield-production-secret-key-change-in-prod-2026

# Key for Evidence File Encryption (Defaults to SECRET_KEY if omitted)
EVIDENCE_ENCRYPTION_KEY=cybershield-evidence-encryption-secret-key-2026

# JWT Expiration in minutes (Default: 60)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database URL (Optional: defaults to SQLite at backend/cybershield.db)
# DATABASE_URL=postgresql://user:password@hostname/dbname

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGINS=http://localhost:5173,https://cyber-shield-ledger-fkg3.vercel.app,https://cyber-shield-ledger.vercel.app

# CORS Regex for Vercel Preview Deployments
CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Google Gemini AI Integration Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Blockchain Smart Contract Config (Optional for Polygon Amoy / Ethereum)
BLOCKCHAIN_RPC=https://rpc-amoy.polygon.technology
CONTRACT_ADDRESS=
PRIVATE_KEY=
CHAIN_ID=80002
